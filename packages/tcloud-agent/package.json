{
  "name": "@tangle-network/tcloud-agent",
  "version": "0.5.0",
  "description": "Agent run-loop primitive over Tangle sandbox transports — runs an AgentProfile against a brief with criterion gates, budget caps, and streaming events. Includes TangleToolProvider for Pi tool integration.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "keywords": [
    "ai",
    "agent",
    "agent-runner",
    "agent-loop",
    "llm",
    "tangle",
    "sandbox",
    "bridge",
    "tool-use",
    "pi-package"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pi-extension": {
      "types": "./dist/pi-extension.d.ts",
      "import": "./dist/pi-extension.js"
    }
  },
  "pi": {
    "extensions": [
      "./src/pi-extension.ts"
    ]
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "prepublishOnly": "node ../../scripts/check-cohort-ranges.mjs && pnpm build"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.52",
    "@tangle-network/sandbox": ">=0.55.3 <0.56.0",
    "@tangle-network/tcloud": "workspace:^",
    "viem": "^2.56.9"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.87.1"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@types/node": "^26.6.3",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "license": "(MIT OR Apache-2.0)",
  "author": "Tangle Network",
  "homepage": "https://github.com/tangle-network/tcloud/tree/main/packages/tcloud-agent#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tangle-network/tcloud.git",
    "directory": "packages/tcloud-agent"
  },
  "bugs": {
    "url": "https://github.com/tangle-network/tcloud/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
