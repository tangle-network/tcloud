{
  "name": "@tangle-network/tcloud-attestation",
  "version": "0.1.1",
  "description": "Fail-closed attestation parsing and policy checks for Tangle TEE sandboxes",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "node ../../scripts/check-cohort-ranges.mjs && pnpm build",
    "test": "vitest run",
    "check-types": "tsc --noEmit"
  },
  "files": [
    "dist"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=18"
  }
}
