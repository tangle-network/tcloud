{
  "name": "@tangle-network/tcloud-relayer",
  "version": "0.1.0",
  "description": "Gas relayer — submits shielded withdrawal transactions on behalf of users",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "prepublishOnly": "node ../../scripts/check-cohort-ranges.mjs && pnpm build",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "ethers": "^6.17.0",
    "hono": "^4.13.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  },
  "license": "MIT"
}
